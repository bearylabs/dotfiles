#!/usr/bin/env bash
set -euo pipefail

VERSION="0.2.15"
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f "$SCRIPT_SOURCE")"
else
  # Git Bash installations do not consistently include readlink. Native
  # Windows setup uses a launcher rather than a symlink, so resolving the
  # physical parent directory is sufficient there.
  SCRIPT_DIR="${SCRIPT_SOURCE%/*}"
  [[ "$SCRIPT_DIR" == "$SCRIPT_SOURCE" ]] && SCRIPT_DIR=.
  SCRIPT_PATH="$(cd -P "$SCRIPT_DIR" && pwd -P)/${SCRIPT_SOURCE##*/}"
fi
REPO="$(cd "${SCRIPT_PATH%/*}" && pwd -P)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_FILE="$CONFIG_HOME/dotctl/config"
STOW_DIR="$REPO/stow"
DRY_RUN=false
YES=false
VERBOSE=false
COLOR=true
ORIGINAL_ARGS=("$@")
SELECTED_PROFILE=""
SCOOP_READY=false

if [[ ! -t 1 || -n "${NO_COLOR:-}" ]]; then COLOR=false; fi
red='\033[31m'; green='\033[32m'; yellow='\033[33m'; blue='\033[34m'; reset='\033[0m'
color() { $COLOR && printf '%b' "$1" || true; }
info() { printf '%b==>%b %s\n' "$(color "$blue")" "$(color "$reset")" "$*"; }
ok() { printf '%b✓%b %s\n' "$(color "$green")" "$(color "$reset")" "$*"; }
warn() { printf '%bwarning:%b %s\n' "$(color "$yellow")" "$(color "$reset")" "$*" >&2; }
die() { printf '%berror:%b %s\n' "$(color "$red")" "$(color "$reset")" "$*" >&2; exit 1; }

show_cmd() { printf '  '; printf '%q ' "$@"; printf '\n'; }
run() {
  if $VERBOSE || $DRY_RUN; then show_cmd "$@"; fi
  $DRY_RUN || "$@"
}
need() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }
confirm() {
  local prompt="$1" answer
  $YES && return 0
  [[ -t 0 && -t 1 ]] || return 1
  read -r -p "$prompt [y/N] " answer
  [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]]
}

usage() {
  cat <<EOF
Usage: dotctl [global flags] <command> [options]

Linux and native Windows dotfiles bootstrap and update wrapper.

Commands:
  init --profile personal|work  Save a profile, link dotctl, and apply all layers
  apply [--only LAYER]          Apply all layers, or system|dotfiles|tools|integrations
  update                        Pull if clean, update everything, then run doctor
  doctor                        Read-only installation checks
  stow                          Apply dotfiles (Stow on Linux, copy on Windows)
  link                          Install dotctl into ~/.local/bin
  help                          Show this help
  version                       Show the version

Global flags:
  --dry-run                     Print mutating commands without running them
  -y, --yes                     Accept prompts (GitHub web login may still be interactive)
  -v, --verbose                 Print commands before running them
  --no-color                    Disable colored output
  -h, --help                    Show help
  -V, --version                 Show version
EOF
}

platform() {
  local kernel id=""
  kernel="$(uname -s)"
  case "$kernel" in
    MINGW*|MSYS*|CYGWIN*) printf 'windows\n'; return ;;
  esac
  [[ -r /etc/os-release ]] && id="$(. /etc/os-release; printf '%s' "${ID:-}")"
  case "$id" in
    nixos)
      if [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/sys/kernel/osrelease /proc/version 2>/dev/null; then
        printf 'nixos-wsl\n'
      else
        printf 'nixos\n'
      fi
      ;;
    ubuntu) printf 'ubuntu\n' ;;
    *) printf 'unsupported\n' ;;
  esac
}

read_profile() {
  local value="$SELECTED_PROFILE"
  [[ -z "$value" && -r "$CONFIG_FILE" ]] && IFS= read -r value < "$CONFIG_FILE"
  case "$value" in personal|work) printf '%s\n' "$value" ;; *) return 1 ;; esac
}

save_profile() {
  local profile="$1"
  case "$profile" in personal|work) ;; *) die "profile must be 'personal' or 'work'" ;; esac
  SELECTED_PROFILE="$profile"
  if $DRY_RUN; then
    info "Would write profile '$profile' to $CONFIG_FILE"
  else
    mkdir -p "$(dirname "$CONFIG_FILE")"
    printf '%s\n' "$profile" > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
  fi
}

load_list() {
  local file="$1" line
  [[ -r "$file" ]] || die "missing data file: $file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line//$'\r'/}"
    read -r line <<< "$line"
    [[ -n "$line" ]] && printf '%s\n' "$line"
  done < "$file"
}

windows_dotctl_wrapper() {
  # Use Git Bash directly. Resolving `bash` through PATH can select the Windows
  # System32 WSL launcher, which cannot open an MSYS C:/... script path.
  printf '#!/bin/bash\n# Managed by dotctl.\nexec /bin/bash %q "$@"\n' "$SCRIPT_PATH"
}

windows_git_bash_launcher() {
  local bash_exe
  bash_exe="$(cygpath -w /bin/bash.exe)"
  printf '@echo off\r\nREM Managed by dotctl.\r\nset "MSYSTEM=MINGW64"\r\n"%s" --login -i\r\n' "$bash_exe"
}

install_windows_git_bash_launcher() {
  local dir="$1" target="$1/gitbash.cmd"
  if [[ -e "$target" ]] && ! grep -Fq 'REM Managed by dotctl.' "$target" 2>/dev/null; then
    die "$target exists and is not managed by dotctl; remove it manually"
  fi
  if $DRY_RUN; then
    info "Would write Windows Git Bash launcher $target"
  else
    windows_git_bash_launcher > "$target"
  fi
  ok "Installed Windows gitbash command $target"
}

windows_add_to_user_path() {
  local windows_dir
  windows_dir="$(cygpath -w "$1")"
  if $DRY_RUN; then
    info "Would add $windows_dir to the Windows user PATH"
    return
  fi
  DOTCTL_WINDOWS_PATH="$windows_dir" powershell.exe -NoProfile -NonInteractive -Command \
    '$target = $env:DOTCTL_WINDOWS_PATH; $userPath = [Environment]::GetEnvironmentVariable("Path", "User"); if (($userPath -split ";") -notcontains $target) { $newPath = if ([string]::IsNullOrEmpty($userPath)) { $target } else { $target + ";" + $userPath }; [Environment]::SetEnvironmentVariable("Path", $newPath, "User") }'
}

link_is_correct() {
  local target="$HOME/.local/bin/dotctl" expected
  if [[ "$(platform)" == windows ]]; then
    [[ -f "$target" ]] || return 1
    expected="$(windows_dotctl_wrapper)"
    [[ "$(<"$target")" == "$expected" ]]
  else
    [[ -L "$target" && "$(readlink -f "$target")" == "$SCRIPT_PATH" ]]
  fi
}

cmd_link() {
  (($# == 0)) || die "link takes no arguments"
  local dir="$HOME/.local/bin" target="$HOME/.local/bin/dotctl"
  if link_is_correct; then
    ok "$target already launches $SCRIPT_PATH"
  elif [[ "$(platform)" == windows ]]; then
    if [[ -e "$target" ]] && ! grep -Fqx '# Managed by dotctl.' "$target" 2>/dev/null; then
      die "$target exists and is not managed by dotctl; remove it manually"
    fi
    run mkdir -p "$dir"
    if $DRY_RUN; then
      info "Would write Git Bash launcher $target"
    else
      windows_dotctl_wrapper > "$target"
      chmod +x "$target"
    fi
    ok "Installed Git Bash launcher $target"
  else
    if [[ -e "$target" && ! -L "$target" ]]; then
      die "$target exists and is not a symlink; remove it manually"
    fi
    run mkdir -p "$dir"
    run ln -sfn "$SCRIPT_PATH" "$target"
    ok "Linked $target -> $SCRIPT_PATH"
  fi
  if [[ "$(platform)" == windows ]]; then
    install_windows_git_bash_launcher "$dir"
    windows_add_to_user_path "$dir"
  fi
  case ":$PATH:" in *":$dir:"*) ;; *) warn "$dir is not on PATH; add it to your shell startup file, then start a new shell" ;; esac
}

ubuntu_prerequisites() {
  local package file
  local -a wanted=() missing=()
  shopt -s nullglob
  local -a files=("$REPO"/packages/ubuntu-*.txt)
  shopt -u nullglob
  ((${#files[@]})) || die "no packages/ubuntu-*.txt files found"
  for file in "${files[@]}"; do
    while IFS= read -r package; do wanted+=("$package"); done < <(load_list "$file")
  done
  for package in "${wanted[@]}"; do
    dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -q '^ii ' || missing+=("$package")
  done
  if ((${#missing[@]})); then
    info "Installing missing Ubuntu essentials: ${missing[*]}"
    run sudo apt-get update
    run sudo apt-get install -y --no-install-recommends "${missing[@]}"
  else
    ok "Ubuntu essentials are installed"
  fi
}

nixos_config_for_platform() {
  case "$1" in
    nixos) printf '%s/nix/configuration.nix\n' "$REPO" ;;
    nixos-wsl) printf '%s/nix/configuration.wsl.nix\n' "$REPO" ;;
    *) die "internal error: invalid NixOS platform $1" ;;
  esac
}

nixos_entrypoint_content() {
  printf 'import %s\n' "$(nixos_config_for_platform "$1")"
}

ensure_nixos_entrypoint() {
  local p="$1" config target expected current backup
  config="$(nixos_config_for_platform "$p")"
  target="/etc/nixos/configuration.nix"
  expected="$(nixos_entrypoint_content "$p")"
  [[ -r "$config" ]] || die "missing NixOS configuration: $config"

  if [[ -f "$target" && ! -L "$target" ]]; then
    current="$(<"$target")"
    if [[ "$current" == "${expected%$'\n'}" ]]; then
      ok "$target imports $config"
      return
    fi
  fi

  info "Writing NixOS entrypoint $target -> $config"
  run sudo install -d -m 755 /etc/nixos
  if [[ -e "$target" || -L "$target" ]]; then
    backup="$target.dotctl-backup.$(date +%Y%m%d%H%M%S)"
    warn "backing up existing $target to $backup"
    run sudo cp -aP "$target" "$backup"
    run sudo rm -f "$target"
  fi
  if $DRY_RUN; then
    show_cmd sudo tee "$target" "<<<" "$expected"
    show_cmd sudo chmod 644 "$target"
  else
    printf '%s' "$expected" | sudo tee "$target" >/dev/null
    sudo chmod 644 "$target"
  fi
  ok "$target imports $config"
}

nixos_rebuild() {
  local p="$1"
  ensure_nixos_entrypoint "$p"
  run sudo nixos-rebuild switch
}

windows_refresh_scoop_path() {
  local scoop_command="" scoop_dir=""
  scoop_command="$(powershell.exe -NoProfile -NonInteractive -Command '(Get-Command scoop -ErrorAction SilentlyContinue).Source' 2>/dev/null | tr -d '\r' || true)"
  if [[ -n "$scoop_command" ]]; then
    scoop_dir="$(dirname "$(cygpath -u "$scoop_command")")"
  elif [[ -n "${SCOOP:-}" ]]; then
    scoop_dir="$(cygpath -u "$SCOOP")/shims"
  elif [[ -n "${USERPROFILE:-}" ]]; then
    scoop_dir="$(cygpath -u "$USERPROFILE")/scoop/shims"
  else
    scoop_dir="$HOME/scoop/shims"
  fi
  case ":$PATH:" in *":$scoop_dir:"*) ;; *) export PATH="$scoop_dir:$PATH" ;; esac
}

windows_refresh_user_path() {
  local windows_dir unix_dir
  while IFS= read -r windows_dir; do
    windows_dir="${windows_dir//$'\r'/}"
    [[ -n "$windows_dir" ]] || continue
    unix_dir="$(cygpath -u "$windows_dir" 2>/dev/null || true)"
    [[ -n "$unix_dir" && -d "$unix_dir" ]] || continue
    case ":$PATH:" in *":$unix_dir:"*) ;; *) export PATH="$PATH:$unix_dir" ;; esac
  done < <(powershell.exe -NoProfile -NonInteractive -Command '([Environment]::GetEnvironmentVariable("Path", "User") -split ";") | ForEach-Object { if ($_){ [Environment]::ExpandEnvironmentVariables($_) } }' 2>/dev/null)
  hash -r
}

windows_powershell_is_elevated() {
  powershell.exe -NoProfile -NonInteractive -Command \
    '$identity = [Security.Principal.WindowsIdentity]::GetCurrent(); $principal = [Security.Principal.WindowsPrincipal]::new($identity); if ($principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { exit 0 } else { exit 1 }' \
    >/dev/null 2>&1
}

install_scoop() {
  local run_as_admin=0
  if windows_powershell_is_elevated; then
    run_as_admin=1
    info "PowerShell is elevated; allowing Scoop to install for the current Windows user"
  fi

  DOTCTL_SCOOP_RUN_AS_ADMIN="$run_as_admin" powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \
    '$ErrorActionPreference = "Stop"; $installer = Join-Path ([IO.Path]::GetTempPath()) ("dotctl-scoop-" + [guid]::NewGuid().ToString("N") + ".ps1"); try { Invoke-RestMethod -Uri https://get.scoop.sh -OutFile $installer; if ($env:DOTCTL_SCOOP_RUN_AS_ADMIN -eq "1") { & $installer -RunAsAdmin } else { & $installer }; if (-not $?) { throw "Scoop installer failed" } } finally { Remove-Item -LiteralPath $installer -Force -ErrorAction SilentlyContinue }'
}

ensure_scoop() {
  $SCOOP_READY && return
  need powershell.exe
  need cygpath
  windows_refresh_scoop_path
  if ! command -v scoop >/dev/null 2>&1; then
    info "Installing Scoop for the current Windows user"
    if $DRY_RUN; then
      show_cmd install_scoop
      return
    fi
    install_scoop
    windows_refresh_scoop_path
    command -v scoop >/dev/null 2>&1 || die "Scoop installation did not make scoop available; expected it below the current Windows user profile"
  fi
  info "Updating Scoop"
  run scoop update
  SCOOP_READY=true
}

scoop_package_installed() {
  local package="$1" prefix="" unix_prefix=""
  prefix="$(scoop prefix "$package" 2>/dev/null | tr -d '\r' || true)"
  [[ -n "$prefix" ]] || return 1
  unix_prefix="$(cygpath -u "$prefix" 2>/dev/null || true)"
  [[ -n "$unix_prefix" && -d "$unix_prefix" ]]
}

windows_prerequisites() {
  local mode="${1:-apply}" package file="$REPO/packages/windows-scoop.txt"
  local -a wanted=() missing=()
  ensure_scoop
  while IFS= read -r package; do wanted+=("$package"); done < <(load_list "$file")
  for package in "${wanted[@]}"; do
    if $DRY_RUN && ! command -v scoop >/dev/null 2>&1; then
      missing+=("$package")
    elif ! scoop_package_installed "$package"; then
      missing+=("$package")
    fi
  done
  if ((${#missing[@]})); then
    info "Installing missing Windows prerequisites with Scoop: ${missing[*]}"
    run scoop install "${missing[@]}"
  else
    ok "Windows Scoop prerequisites are installed"
  fi
  if [[ "$mode" == update ]] && ((${#wanted[@]})); then run scoop update "${wanted[@]}"; fi
  windows_refresh_user_path
}

system_layer() {
  local mode="${1:-apply}" p
  p="$(platform)"
  info "System prerequisites ($p)"
  case "$p" in
    windows) windows_prerequisites "$mode" ;;
    ubuntu) ubuntu_prerequisites ;;
    nixos|nixos-wsl)
      if [[ "$mode" == update ]]; then run sudo nix-channel --update; fi
      nixos_rebuild "$p"
      ;;
    *) die "unsupported platform (supported: NixOS, NixOS-WSL, Ubuntu, Windows via Git Bash)" ;;
  esac
}

github_auth() {
  need gh
  if gh auth token --hostname github.com >/dev/null 2>&1; then
    ok "GitHub authentication for github.com is valid"
    return
  fi
  if [[ ! -t 0 || ! -t 1 ]]; then
    die "GitHub authentication is required. Set GH_TOKEN or run: gh auth login --hostname github.com --web"
  fi
  confirm "Authenticate gh with github.com in the browser?" || die "GitHub authentication is required before mise tools can be installed"
  run gh auth login --hostname github.com --web
  $DRY_RUN && return
  gh auth token --hostname github.com >/dev/null 2>&1 || die "gh login completed but no valid github.com token is available"
  ok "GitHub authentication validated"
}

ubuntu_git_credential_manager() {
  command -v git-credential-manager >/dev/null 2>&1 && {
    ok "Git Credential Manager is installed"
    return
  }

  local machine asset_arch tag version url package
  machine="$(uname -m)"
  case "$machine" in
    x86_64) asset_arch=x64 ;;
    aarch64|arm64) asset_arch=arm64 ;;
    *) die "Git Credential Manager does not support Ubuntu architecture: $machine" ;;
  esac

  if $DRY_RUN; then
    info "Would install the latest Git Credential Manager release for linux-$asset_arch"
    return
  fi

  tag="$(gh api repos/git-ecosystem/git-credential-manager/releases/latest --jq .tag_name)"
  version="${tag#v}"
  url="https://github.com/git-ecosystem/git-credential-manager/releases/download/$tag/gcm-linux-$asset_arch-$version.deb"
  package="$(mktemp --suffix=.deb)"
  if ! curl -fsSL "$url" -o "$package"; then
    rm -f "$package"
    die "failed to download Git Credential Manager $tag"
  fi
  if ! sudo apt-get install -y "$package"; then
    rm -f "$package"
    die "failed to install Git Credential Manager $tag"
  fi
  rm -f "$package"
  ok "Git Credential Manager $version is installed"
}

git_profile_identity() {
  case "$1" in
    personal) printf 'bearylabs\tinfo@beary.cloud\n' ;;
    work) printf 'hendrik-rudek\thendrik.rudek@siempelkamp.com\n' ;;
    *) return 1 ;;
  esac
}

gpg_secret_key_for_email() {
  local email="$1"
  { gpg --list-secret-keys --with-colons "$email" 2>/dev/null || true; } | awk -F: '$1 == "sec" { print $5; exit }'
}

ensure_gpg_agent_config() {
  local pinentry config cache_ttl=86400
  pinentry="$(command -v pinentry-curses || command -v pinentry || true)"
  [[ -n "$pinentry" ]] || die "required command not found: pinentry-curses"
  config="$HOME/.gnupg/gpg-agent.conf"
  export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null || true)}"
  if [[ -r "$config" ]] \
    && grep -Fxq "pinentry-program $pinentry" "$config" \
    && grep -Fxq "default-cache-ttl $cache_ttl" "$config" \
    && grep -Fxq "max-cache-ttl $cache_ttl" "$config" \
    && grep -Fxq "default-cache-ttl-ssh $cache_ttl" "$config" \
    && grep -Fxq "max-cache-ttl-ssh $cache_ttl" "$config"; then
    return
  fi
  if $DRY_RUN; then
    info "Would configure gpg-agent pinentry and cache TTL: $cache_ttl seconds"
    return
  fi
  mkdir -p "$HOME/.gnupg"
  chmod 700 "$HOME/.gnupg"
  if [[ -e "$config" ]]; then
    awk '$1 != "pinentry-program" && $1 != "default-cache-ttl" && $1 != "max-cache-ttl" && $1 != "default-cache-ttl-ssh" && $1 != "max-cache-ttl-ssh"' "$config" > "$config.tmp"
    mv "$config.tmp" "$config"
  fi
  printf '%s\n' \
    "pinentry-program $pinentry" \
    "default-cache-ttl $cache_ttl" \
    "max-cache-ttl $cache_ttl" \
    "default-cache-ttl-ssh $cache_ttl" \
    "max-cache-ttl-ssh $cache_ttl" >> "$config"
  chmod 600 "$config"
  gpgconf --kill gpg-agent 2>/dev/null || true
  ok "Configured gpg-agent pinentry and cache TTL: $cache_ttl seconds"
}

ensure_git_credential_gpg_store() {
  local profile="$1" expected_name expected_email key cmd
  [[ "$profile" == work ]] || return 0
  local -a missing=()
  for cmd in gpg pass git-credential-manager; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if ! command -v pinentry-curses >/dev/null 2>&1 && ! command -v pinentry >/dev/null 2>&1; then
    missing+=("pinentry-curses")
  fi
  if ((${#missing[@]})); then
    if $DRY_RUN; then
      info "Would require commands for gpg-backed Git credentials: ${missing[*]}"
      return
    fi
    die "required command(s) not found: ${missing[*]}"
  fi
  IFS=$'\t' read -r expected_name expected_email < <(git_profile_identity "$profile")
  ensure_gpg_agent_config

  key="$(gpg_secret_key_for_email "$expected_email")"
  if [[ -z "$key" ]]; then
    if $DRY_RUN; then
      info "Would generate a local GPG key for Git credentials: $expected_name <$expected_email>"
      key="<new-gpg-key>"
    else
      if [[ ! -t 0 || ! -t 1 ]]; then
        die "GPG key for $expected_email is missing. Run interactively: gpg --quick-generate-key '$expected_name <$expected_email>' default default never && pass init <key-id>"
      fi
      confirm "Generate a local GPG key for Git credentials ($expected_name <$expected_email>)?" || die "GPG key is required for credentialStore=gpg"
      run gpg --quick-generate-key "$expected_name <$expected_email>" default default never
      key="$(gpg_secret_key_for_email "$expected_email")"
      [[ -n "$key" ]] || die "failed to find the generated GPG key for $expected_email"
    fi
  else
    ok "GPG secret key for $expected_email is available"
  fi

  if [[ -r "$HOME/.password-store/.gpg-id" ]]; then
    ok "pass password store is initialized"
  else
    info "Initializing pass for Git Credential Manager"
    run pass init "$key"
  fi

  if [[ -f "$HOME/.git-credentials" ]]; then
    if confirm "Remove plaintext Git credential file $HOME/.git-credentials?"; then
      run rm -f "$HOME/.git-credentials"
      ok "Removed plaintext Git credential file"
    else
      warn "plaintext Git credential file remains: $HOME/.git-credentials"
    fi
  fi
}

profile_prerequisites() {
  local profile p
  profile="$(read_profile)" || die "no valid profile; run: dotctl init --profile personal|work"
  p="$(platform)"
  if [[ "$profile" == work && "$p" == ubuntu ]]; then
    ubuntu_git_credential_manager
  fi
  ensure_git_credential_gpg_store "$profile"
}

stow_packages() {
  local profile="$1" package
  local -a packages=()
  while IFS= read -r package; do packages+=("$package"); done < <(load_list "$REPO/packages/stow-common.txt")
  packages+=("git-$profile")
  printf '%s\n' "${packages[@]}"
}

stow_layer() {
  local profile inactive package
  profile="$(read_profile)" || die "no valid profile; run: dotctl init --profile personal|work"
  [[ "$profile" == personal ]] && inactive=work || inactive=personal
  need stow
  local -a packages=()
  while IFS= read -r package; do
    [[ -d "$STOW_DIR/$package" ]] || die "unknown Stow package in package data: $package"
    packages+=("$package")
  done < <(stow_packages "$profile")

  info "Simulating Stow changes for profile '$profile'"
  stow -n -d "$STOW_DIR" -t "$HOME" -D "git-$inactive" -R "${packages[@]}"
  if $DRY_RUN; then
    show_cmd stow -d "$STOW_DIR" -t "$HOME" -D "git-$inactive" -R "${packages[@]}"
  else
    run stow -d "$STOW_DIR" -t "$HOME" -D "git-$inactive" -R "${packages[@]}"
  fi
  ok "Stow packages selected for '$profile'"
}

copy_tree() {
  local source="$1" target="$2"
  [[ -d "$source" ]] || die "missing configuration directory: $source"
  run mkdir -p "$target"
  run cp -R "$source/." "$target/"
}

windows_dotfiles_layer() {
  need cygpath
  local local_appdata
  [[ -n "${LOCALAPPDATA:-}" ]] || die "LOCALAPPDATA is not set"
  local_appdata="$(cygpath -u "$LOCALAPPDATA")"
  info "Copying shared configuration for native Windows"
  copy_tree "$STOW_DIR/agents/.agents" "$HOME/.agents"
  copy_tree "$STOW_DIR/pi/.pi/agent" "$HOME/.pi/agent"
  copy_tree "$STOW_DIR/herdr/.config/herdr" "$HOME/.config/herdr"
  copy_tree "$STOW_DIR/nvim/.config/nvim" "$local_appdata/nvim"
  run mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.copilot" "$HOME/.local/bin"
  install_windows_git_bash_launcher "$HOME/.local/bin"
  windows_add_to_user_path "$HOME/.local/bin"
  ok "Copied Windows configuration"
}

dotfiles_layer() {
  if [[ "$(platform)" == windows ]]; then windows_dotfiles_layer; else stow_layer; fi
}

mise_workdir() {
  if [[ "$(platform)" == windows ]]; then printf '%s/windows\n' "$REPO"; else printf '%s\n' "$REPO"; fi
}

mise_config() {
  if [[ "$(platform)" == windows ]]; then printf '%s/windows/mise.toml\n' "$REPO"; else printf '%s/.config/mise/config.toml\n' "$HOME"; fi
}

ensure_mise() {
  local mode="${1:-apply}" binary="$HOME/.local/bin/mise" installer
  export PATH="$HOME/.local/bin:$PATH"
  if [[ "$(platform)" == windows ]]; then
    ensure_scoop
    windows_refresh_scoop_path
    if ! command -v mise >/dev/null 2>&1; then
      info "Installing mise with Scoop"
      run scoop install mise
      windows_refresh_scoop_path
    elif [[ "$mode" == update ]]; then
      info "Updating mise with Scoop"
      run scoop update mise
    fi
    return
  fi

  if [[ ! -x "$binary" ]]; then
    info "Installing mise from mise.run"
    if $DRY_RUN; then
      info "Would download and run the official mise installer"
      return
    fi
    installer="$(mktemp)"
    if ! curl -fsSL https://mise.run -o "$installer" || ! sh "$installer"; then
      rm -f "$installer"
      die "failed to install mise"
    fi
    rm -f "$installer"
    [[ -x "$binary" ]] || die "mise installer did not create $binary"
  elif [[ "$mode" == update ]]; then
    info "Updating mise itself"
    run "$binary" self-update --yes
  fi
}

ensure_windows_bash_environment() {
  local profile="$HOME/.bash_profile"
  local mise_marker='# Managed by dotctl: Windows environment'
  local zoxide_marker='# Managed by dotctl: zoxide activation'
  if ! grep -Fqx "$mise_marker" "$profile" 2>/dev/null; then
    if $DRY_RUN; then
      info "Would add mise activation to $profile"
    else
      {
        printf '\n%s\n' "$mise_marker"
        printf 'export PATH="$HOME/.local/bin:$PATH"\n'
        printf 'if command -v mise >/dev/null 2>&1; then eval "$(mise activate bash)"; fi\n'
      } >> "$profile"
    fi
  fi
  if ! grep -Fqx "$zoxide_marker" "$profile" 2>/dev/null; then
    if $DRY_RUN; then
      info "Would add zoxide activation to $profile"
    else
      {
        printf '\n%s\n' "$zoxide_marker"
        printf 'if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init bash)"; fi\n'
      } >> "$profile"
    fi
  fi
  ok "Configured mise and zoxide for future Git Bash sessions"
}

ensure_windows_powershell_environment() {
  local shell
  local command='$miseMarker = "# Managed by dotctl: mise activation"; $zoxideMarker = "# Managed by dotctl: zoxide activation"; $profilePath = $PROFILE.CurrentUserAllHosts; $content = if (Test-Path -LiteralPath $profilePath) { Get-Content -LiteralPath $profilePath -Raw } else { "" }; if (-not $content.Contains($miseMarker)) { New-Item -ItemType Directory -Path (Split-Path -Parent $profilePath) -Force | Out-Null; $block = "`r`n$miseMarker`r`nif (Get-Command mise -ErrorAction SilentlyContinue) { (&mise activate pwsh) | Out-String | Invoke-Expression }`r`n"; Add-Content -LiteralPath $profilePath -Value $block -Encoding UTF8 }; if (-not $content.Contains($zoxideMarker)) { New-Item -ItemType Directory -Path (Split-Path -Parent $profilePath) -Force | Out-Null; $block = "`r`n$zoxideMarker`r`nif (Get-Command zoxide -ErrorAction SilentlyContinue) { (zoxide init powershell | Out-String) | Invoke-Expression }`r`n"; Add-Content -LiteralPath $profilePath -Value $block -Encoding UTF8 }; $shims = ((& mise doctor --json | Out-String | ConvertFrom-Json).dirs.shims); $userPath = [Environment]::GetEnvironmentVariable("Path", "User"); if (($userPath -split ";") -notcontains $shims) { $newPath = if ([string]::IsNullOrEmpty($userPath)) { $shims } else { $shims + ";" + $userPath }; [Environment]::SetEnvironmentVariable("Path", $newPath, "User") }'
  for shell in powershell.exe pwsh.exe; do
    command -v "$shell" >/dev/null 2>&1 || continue
    if $DRY_RUN; then show_cmd "$shell" -NoProfile -NonInteractive -Command "$command"; else "$shell" -NoProfile -NonInteractive -Command "$command"; fi
  done
  ok "Configured mise and zoxide for future PowerShell sessions"
}

windows_has_wsl_distribution() {
  powershell.exe -NoProfile -NonInteractive -Command \
    '$root = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Lxss"; $installed = Get-ChildItem -LiteralPath $root -ErrorAction SilentlyContinue | ForEach-Object { Get-ItemProperty -LiteralPath $_.PSPath -ErrorAction SilentlyContinue } | Where-Object { $_.DistributionName } | Select-Object -First 1; if ($null -ne $installed) { exit 0 }; exit 1' \
    >/dev/null 2>&1
}

ensure_windows_herdr_wsl_prompt() {
  local source="$REPO/windows/herdr-wsl-prompt.ps1"
  local installer="$REPO/windows/install-herdr-wsl-prompt.ps1"
  local target shell windows_home installer_windows

  case "$(platform)" in
    windows)
      if ! windows_has_wsl_distribution; then
        info "No installed WSL distribution detected; skipping Herdr WSL PowerShell integration"
        return
      fi
      target="$HOME/.config/dotctl/herdr-wsl-prompt.ps1"
      installer_windows="$(cygpath -w "$installer")"
      ;;
    nixos-wsl)
      windows_home="$(powershell.exe -NoProfile -NonInteractive -Command '[Environment]::GetFolderPath("UserProfile")' | tr -d '\r')"
      [[ -n "$windows_home" ]] || die "could not resolve the Windows user profile from WSL"
      target="$(wslpath -u "$windows_home")/.config/dotctl/herdr-wsl-prompt.ps1"
      installer_windows="$(wslpath -w "$installer")"
      ;;
    *) return ;;
  esac

  [[ -f "$source" ]] || die "missing Herdr WSL PowerShell integration: $source"
  [[ -f "$installer" ]] || die "missing Herdr WSL PowerShell installer: $installer"
  run mkdir -p "${target%/*}"
  run cp "$source" "$target"
  for shell in powershell.exe pwsh.exe; do
    command -v "$shell" >/dev/null 2>&1 || continue
    if $DRY_RUN; then
      show_cmd "$shell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$installer_windows"
    else
      "$shell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$installer_windows"
    fi
  done
  ok "Configured Herdr WSL cwd reporting for future marked PowerShell sessions"
}

install_windows_mise_global_config() {
  local source="$1" target="$HOME/.config/mise/config.toml"
  info "Installing global mise tool configuration for Windows shells"
  run mkdir -p "${target%/*}"
  run cp "$source" "$target"
}

tools_layer() {
  local config workdir
  ensure_mise "${1:-apply}"
  need mise
  config="$(mise_config)"
  workdir="$(mise_workdir)"
  [[ -e "$config" ]] || $DRY_RUN || die "mise configuration is missing: $config"
  info "Trusting the repository-managed mise configuration"
  run mise trust "$config"
  if [[ "$(platform)" == windows ]]; then install_windows_mise_global_config "$config"; fi
  info "Installing mise-managed tools"
  run mise install --cd "$workdir"
  if [[ "$(platform)" == windows ]]; then
    ensure_windows_bash_environment
    ensure_windows_powershell_environment
    ensure_windows_herdr_wsl_prompt
  elif [[ "$(platform)" == nixos-wsl ]]; then
    ensure_windows_herdr_wsl_prompt
  fi
}

herdr_plugins_file() {
  if [[ "$(platform)" == windows ]]; then
    printf '%s/packages/herdr-plugins-windows.txt\n' "$REPO"
  else
    printf '%s/packages/herdr-plugins.txt\n' "$REPO"
  fi
}

sync_integrations() {
  local source integration plugin_file workdir
  need mise
  plugin_file="$(herdr_plugins_file)"
  workdir="$(mise_workdir)"
  info "Syncing Herdr plugins"
  while IFS= read -r source; do run mise exec --cd "$workdir" -- herdr plugin install "$source" --yes; done < <(load_list "$plugin_file")
  info "Syncing Herdr agent integrations"
  while IFS= read -r integration; do run mise exec --cd "$workdir" -- herdr integration install "$integration"; done < <(load_list "$REPO/packages/herdr-integrations.txt")
  if [[ "$(platform)" != windows ]]; then
    if command -v az >/dev/null 2>&1 || $DRY_RUN; then
      run mise run --cd "$REPO" azure:extensions
    else
      die "Azure CLI is missing after mise install"
    fi
  fi
}

apply_layers() {
  local only="${1:-}" mode="${2:-apply}"
  case "$only" in ''|system|dotfiles|tools|integrations) ;; *) die "--only must be system, dotfiles, tools, or integrations" ;; esac
  if [[ -z "$only" || "$only" == system ]]; then system_layer "$mode"; fi
  if [[ -z "$only" || "$only" == tools ]] && [[ "$(platform)" != windows ]]; then
    github_auth
    profile_prerequisites
  fi
  if [[ -z "$only" || "$only" == dotfiles ]]; then dotfiles_layer; fi
  if [[ -z "$only" || "$only" == tools ]]; then tools_layer "$mode"; fi
  if [[ -z "$only" || "$only" == integrations ]]; then sync_integrations; fi
}

cmd_init() {
  local profile=""
  while (($#)); do
    case "$1" in
      --profile) (($# > 1)) || die "--profile requires a value"; profile="$2"; shift 2 ;;
      --profile=*) profile="${1#*=}"; shift ;;
      *) die "unknown init option: $1" ;;
    esac
  done
  [[ -n "$profile" ]] || die "init requires --profile personal|work"
  save_profile "$profile"
  cmd_link
  apply_layers
}

cmd_apply() {
  local only=""
  while (($#)); do
    case "$1" in
      --only) (($# > 1)) || die "--only requires a value"; only="$2"; shift 2 ;;
      --only=*) only="${1#*=}"; shift ;;
      *) die "unknown apply option: $1" ;;
    esac
  done
  if [[ -z "$only" || "$only" == dotfiles ]]; then
    read_profile >/dev/null || die "no valid profile; run: dotctl init --profile personal|work"
  fi
  apply_layers "$only"
}

update_repo() {
  need git
  if [[ -n "$(git -C "$REPO" status --porcelain)" ]]; then
    warn "repository has uncommitted changes; skipping git pull and updating installed software from the current checkout"
    return 0
  fi
  git -C "$REPO" symbolic-ref -q HEAD >/dev/null || die "refusing update: HEAD is detached"
  local upstream
  upstream="$(git -C "$REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || die "refusing update: current branch has no upstream"
  info "Fast-forwarding from $upstream"
  run git -C "$REPO" pull --ff-only
  REPO_PULLED=true
}

cmd_update() {
  (($# == 0)) || die "update takes no arguments"
  if [[ "${DOTCTL_UPDATE_REEXECED:-0}" != 1 ]]; then
    REPO_PULLED=false
    update_repo
    if $REPO_PULLED && ! $DRY_RUN; then
      export DOTCTL_UPDATE_REEXECED=1
      if [[ "$(platform)" == windows ]]; then
        exec /bin/bash "$REPO/dotctl" "${ORIGINAL_ARGS[@]}"
      else
        exec "$REPO/dotctl" "${ORIGINAL_ARGS[@]}"
      fi
    fi
  fi
  read_profile >/dev/null || die "no valid profile; run: dotctl init --profile personal|work"
  system_layer update
  if [[ "$(platform)" != windows ]]; then github_auth; fi
  dotfiles_layer
  tools_layer update
  run mise upgrade --cd "$(mise_workdir)"
  sync_integrations
  cmd_doctor
}

check_ok() { ok "$1"; }
check_fail() { warn "$1"; DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1)); }
check_cmd() {
  if command -v "$1" >/dev/null 2>&1; then check_ok "$1 is available"; else check_fail "$1 is missing"; fi
}

cmd_doctor() {
  (($# == 0)) || die "doctor takes no arguments"
  DOCTOR_FAILURES=0
  local p profile upstream target package source integration
  p="$(platform)"
  [[ "$p" != unsupported ]] && check_ok "platform: $p" || check_fail "unsupported platform"
  if profile="$(read_profile)"; then check_ok "profile: $profile"; else check_fail "profile is missing or invalid in $CONFIG_FILE"; profile=""; fi

  if git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then check_ok "repository: $REPO"; else check_fail "$REPO is not a Git work tree"; fi
  git -C "$REPO" symbolic-ref -q HEAD >/dev/null 2>&1 && check_ok "repository HEAD is attached" || check_fail "repository HEAD is detached"
  if upstream="$(git -C "$REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; then check_ok "upstream: $upstream"; else check_fail "current branch has no upstream"; fi
  [[ -z "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]] && check_ok "repository is clean" || warn "repository has uncommitted changes (update will refuse)"

  case "$p" in
    windows)
      windows_refresh_scoop_path
      windows_refresh_user_path
      for package in git powershell.exe scoop mise; do check_cmd "$package"; done
      if command -v mise >/dev/null 2>&1; then
        local executable
        while IFS= read -r executable; do
          if mise which --cd "$(mise_workdir)" "$executable" >/dev/null 2>&1; then check_ok "$executable is installed by mise"; else check_fail "$executable is missing from mise"; fi
        done <<'EOF'
node
nvim
rg
fd
fzf
zoxide
lazygit
claude
codex
copilot
herdr
pi
tree-sitter
EOF
      fi
      check_cmd gcc
      if [[ -f "$HOME/.local/bin/gitbash.cmd" ]] && grep -Fq 'REM Managed by dotctl.' "$HOME/.local/bin/gitbash.cmd"; then
        check_ok "gitbash launcher is installed for PowerShell and Command Prompt"
      else
        check_fail "Windows gitbash launcher is missing"
      fi
      [[ -d "$HOME/.agents" ]] && check_ok "agent skills are copied" || check_fail "$HOME/.agents is missing"
      [[ -d "$HOME/.pi/agent" ]] && check_ok "Pi configuration is copied" || check_fail "$HOME/.pi/agent is missing"
      [[ -f "$HOME/.config/herdr/config.toml" ]] && check_ok "Herdr configuration is copied" || check_fail "$HOME/.config/herdr/config.toml is missing"
      if windows_has_wsl_distribution; then
        [[ -f "$HOME/.config/dotctl/herdr-wsl-prompt.ps1" ]] && check_ok "Herdr WSL PowerShell integration is installed" || check_fail "Herdr WSL PowerShell integration is missing"
      fi
      if [[ -n "${LOCALAPPDATA:-}" && -f "$(cygpath -u "$LOCALAPPDATA")/nvim/init.lua" ]]; then
        check_ok "Neovim configuration is copied"
      else
        check_fail "Windows Neovim configuration is missing"
      fi
      ;;
    ubuntu)
      local file
      shopt -s nullglob
      local -a ubuntu_files=("$REPO"/packages/ubuntu-*.txt)
      shopt -u nullglob
      for file in "${ubuntu_files[@]}"; do
        while IFS= read -r package; do
          if dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -q '^ii '; then
            check_ok "Ubuntu package: $package"
          else
            check_fail "Ubuntu package missing: $package"
          fi
        done < <(load_list "$file")
      done
      check_cmd mise
      ;;
    nixos|nixos-wsl)
      for package in git gh stow mise; do check_cmd "$package"; done
      check_cmd nixos-rebuild
      if [[ "$p" == nixos-wsl ]]; then
        local windows_home herdr_wsl_prompt
        windows_home="$(powershell.exe -NoProfile -NonInteractive -Command '[Environment]::GetFolderPath("UserProfile")' 2>/dev/null | tr -d '\r')"
        herdr_wsl_prompt=""
        [[ -n "$windows_home" ]] && herdr_wsl_prompt="$(wslpath -u "$windows_home")/.config/dotctl/herdr-wsl-prompt.ps1"
        [[ -n "$herdr_wsl_prompt" && -f "$herdr_wsl_prompt" ]] && check_ok "Herdr WSL PowerShell integration is installed" || check_fail "Herdr WSL PowerShell integration is missing"
      fi
      local expected_nixos_entrypoint current_nixos_entrypoint
      expected_nixos_entrypoint="$(nixos_entrypoint_content "$p")"
      if [[ -f /etc/nixos/configuration.nix && ! -L /etc/nixos/configuration.nix ]]; then
        current_nixos_entrypoint="$(</etc/nixos/configuration.nix)"
        if [[ "$current_nixos_entrypoint" == "$expected_nixos_entrypoint" ]]; then
          check_ok "/etc/nixos/configuration.nix imports the repository config"
        else
          check_fail "/etc/nixos/configuration.nix does not import the repository config"
        fi
      else
        check_fail "/etc/nixos/configuration.nix is missing or is a symlink"
      fi
      ;;
  esac
  if [[ "$p" != windows && "$profile" == work ]]; then
    check_cmd git-credential-manager
    check_cmd gpg
    check_cmd pass
    if command -v pinentry-curses >/dev/null 2>&1 || command -v pinentry >/dev/null 2>&1; then check_ok "pinentry is available"; else check_fail "pinentry-curses is missing"; fi
    local gcm_store
    gcm_store="$(git config --global --includes credential.credentialStore 2>/dev/null || true)"
    [[ "$gcm_store" == gpg ]] && check_ok "Git Credential Manager uses gpg store" || check_fail "Git Credential Manager credentialStore is not gpg"
  fi
  if [[ "$p" != windows && -n "$profile" ]]; then
    local expected_name expected_email
    IFS=$'\t' read -r expected_name expected_email < <(git_profile_identity "$profile")
    if [[ "$(git config --global --includes user.name 2>/dev/null || true)" == "$expected_name" && "$(git config --global --includes user.email 2>/dev/null || true)" == "$expected_email" ]]; then
      check_ok "Git identity matches the '$profile' profile"
    else
      check_fail "Git identity does not match the '$profile' profile"
    fi
    if [[ "$profile" == work ]] && command -v gpg >/dev/null 2>&1; then
      if [[ -n "$(gpg_secret_key_for_email "$expected_email")" ]]; then check_ok "GPG secret key for Git credentials is available"; else check_fail "GPG secret key for $expected_email is missing"; fi
      [[ -r "$HOME/.password-store/.gpg-id" ]] && check_ok "pass password store is initialized" || check_fail "pass password store is not initialized"
      [[ ! -f "$HOME/.git-credentials" ]] && check_ok "no plaintext ~/.git-credentials file" || check_fail "plaintext ~/.git-credentials file exists"
    fi
  fi

  target="$HOME/.local/bin/dotctl"
  link_is_correct && check_ok "dotctl launcher is correct" || check_fail "$target does not launch $SCRIPT_PATH"
  case ":$PATH:" in *":$HOME/.local/bin:"*) check_ok "~/.local/bin is on PATH" ;; *) check_fail "~/.local/bin is not on PATH" ;; esac
  [[ -x "${SHELL:-}" ]] && check_ok "login shell: ${SHELL:-unknown}" || check_fail "SHELL does not name an executable"

  if [[ "$p" != windows ]]; then check_cmd stow; fi
  if [[ "$p" != windows && -n "$profile" ]] && command -v stow >/dev/null 2>&1; then
    local -a packages=()
    while IFS= read -r package; do packages+=("$package"); done < <(stow_packages "$profile")
    if stow -n -d "$STOW_DIR" -t "$HOME" "${packages[@]}" >/dev/null 2>&1; then check_ok "Stow package tree has no conflicts"; else check_fail "Stow reports conflicts"; fi
    local broken=0 unmanaged=0 rel
    for package in "${packages[@]}"; do
      while IFS= read -r -d '' source; do
        rel="${source#"$STOW_DIR/$package/"}"; target="$HOME/$rel"
        if [[ -L "$target" && ! -e "$target" ]]; then
          warn "broken managed link: $target"
          broken=$((broken + 1))
        elif [[ ! -e "$target" || "$(readlink -f "$target")" != "$(readlink -f "$source")" ]]; then
          warn "not linked to the repository: $target"
          unmanaged=$((unmanaged + 1))
        fi
      done < <(find "$STOW_DIR/$package" -type f -print0)
    done
    if ((broken == 0)); then check_ok "no broken managed links"; else check_fail "$broken broken managed link(s)"; fi
    if ((unmanaged == 0)); then check_ok "all selected files are managed by Stow"; else check_fail "$unmanaged file(s) are not stowed"; fi
  fi

  check_cmd mise
  [[ -e "$(mise_config)" ]] && check_ok "mise configuration is present" || check_fail "mise configuration is missing"
  if command -v mise >/dev/null 2>&1; then
    if [[ -z "$(mise ls --cd "$(mise_workdir)" --missing 2>/dev/null)" ]]; then check_ok "mise tools are installed"; else check_fail "mise reports missing tools"; fi
  fi
  if [[ "$p" != windows ]]; then
    check_cmd gh
    if command -v gh >/dev/null 2>&1 && gh auth token --hostname github.com >/dev/null 2>&1; then check_ok "github.com token is available through gh"; else check_fail "github.com authentication/token is unavailable"; fi
  fi

  if command -v mise >/dev/null 2>&1 && mise which --cd "$(mise_workdir)" herdr >/dev/null 2>&1; then
    check_ok "herdr is available"
    local plugins repo_name statuses
    local -a missing_plugins=() missing_integrations=()
    plugins="$(mise exec --cd "$(mise_workdir)" -- herdr plugin list 2>/dev/null || true)"
    while IFS= read -r source; do
      repo_name="${source#*/}"; repo_name="${repo_name%%/*}"
      grep -q "$repo_name" <<< "$plugins" || missing_plugins+=("$repo_name")
    done < <(load_list "$(herdr_plugins_file)")
    if ((${#missing_plugins[@]} == 0)); then
      check_ok "all Herdr plugins are available"
    else
      check_fail "missing Herdr plugins: ${missing_plugins[*]}"
    fi

    statuses="$(mise exec --cd "$(mise_workdir)" -- herdr integration status 2>/dev/null || true)"
    while IFS= read -r integration; do
      grep -Eq "^${integration}: current" <<< "$statuses" || missing_integrations+=("$integration")
    done < <(load_list "$REPO/packages/herdr-integrations.txt")
    if ((${#missing_integrations[@]} == 0)); then
      check_ok "all Herdr integrations are current"
    else
      check_fail "missing or outdated Herdr integrations: ${missing_integrations[*]}"
    fi
  else
    check_fail "herdr is missing"
  fi
  if [[ "$p" != windows ]]; then
    if command -v az >/dev/null 2>&1 && az extension show --name virtual-network-manager >/dev/null 2>&1; then
      check_ok "Azure virtual-network-manager extension is installed"
    else
      check_fail "Azure virtual-network-manager extension is missing"
    fi
  fi

  if ((DOCTOR_FAILURES)); then warn "doctor found $DOCTOR_FAILURES problem(s)"; return 1; fi
  ok "doctor found no problems"
}

# Global flags may appear before or after the command. Command-specific flags are preserved.
args=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    -y|--yes) YES=true ;;
    -v|--verbose) VERBOSE=true ;;
    --no-color) COLOR=false ;;
    -h|--help) args+=(help) ;;
    -V|--version) args+=(version) ;;
    *) args+=("$arg") ;;
  esac
done
set -- "${args[@]}"
command_name="${1:-help}"
(($# == 0)) || shift
case "$command_name" in
  init) cmd_init "$@" ;;
  apply) cmd_apply "$@" ;;
  update) cmd_update "$@" ;;
  doctor) cmd_doctor "$@" ;;
  stow) (($# == 0)) || die "stow takes no arguments"; dotfiles_layer ;;
  link) cmd_link "$@" ;;
  help) usage ;;
  version) printf 'dotctl %s\n' "$VERSION" ;;
  *) die "unknown command: $command_name (run 'dotctl help')" ;;
esac
