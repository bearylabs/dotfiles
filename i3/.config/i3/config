# i3 config
#
# Ported from the previous sway config. Read `man 5 i3` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term ghostty
# Your preferred application launcher
set $menu rofi -show drun

### Output configuration
#
# Pick the active output. X detects a hot-plugged DP/USB-C monitor but never
# enables it, so this has to run before anything that reads the output list
# (polybar, feh). An external monitor takes over as the only screen and the
# laptop panel is switched off.
exec_always --no-startup-id ~/.config/i3/displays.sh
# Re-run the same script whenever an output is plugged or unplugged. The script
# takes a lock itself, so a reload does not stack up watchers.
exec_always --no-startup-id ~/.config/i3/hotplug.sh
#
# The wallpaper is painted by displays.sh rather than here: X11 has no
# compositor-managed background, so feh has to run after the resolution is
# settled or it paints for the old framebuffer size.

### Idle configuration
#
# xss-lock ties the screensaver and logind's sleep/lock signals to i3lock.
# --transfer-sleep-lock makes the lock appear before the system actually sleeps.
exec_always --no-startup-id sh -c 'pkill -x xss-lock; exec xss-lock --transfer-sleep-lock -- i3lock -n -c 1e2030 --clock --indicator --time-str="%H:%M" --date-str="%A, %d %B" --time-color=c8d3f5ff --date-color=c8d3f5ff --insidecolor=00000000 --insidevercolor=00000000 --insidewrongcolor=00000000 --ringcolor=c8d3f5ff --ringvercolor=9ece6aff --ringwrongcolor=f7768eff --linecolor=00000000 --separatorcolor=00000000 --verifcolor=c8d3f5ff --wrongcolor=f7768eff --layoutcolor=c8d3f5ff --keyhlcolor=9ece6aff --bshlcolor=f7768eff --radius=140 --ring-width=8'
# xidlehook drives the staged timeouts. Its timers are cumulative: the screen
# dims at 2 min, locks at 5 min, and the display powers off at 8 min.
# Keep this on one line: the i3 config parser has no line continuations.
exec_always --no-startup-id sh -c 'pkill -x xidlehook; exec xidlehook --timer 120 "brightnessctl -s set 20%" "brightnessctl -r" --timer 180 "loginctl lock-session" "" --timer 180 "xset dpms force off" ""'

### Startup applications
#
# NetworkManager tray applet for clickable Wi-Fi and VPN management.
exec_always --no-startup-id sh -c 'pkill -x nm-applet; exec nm-applet --indicator'
# Notification daemon.
exec_always --no-startup-id sh -c 'pkill -x dunst; exec dunst'
# LocalSend for local file sharing.
exec --no-startup-id localsend_app --hidden
# Re-apply saved desktop theme on i3 start/reload.
exec_always --no-startup-id theme-toggle apply

### Input configuration
#
# Keyboard layout and touchpad/pointer behaviour live in configuration.nix
# (services.xserver.xkb and services.libinput), since X owns input devices.

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    floating_modifier $mod

    # Reload the configuration file
    bindsym $mod+Shift+c reload
    # Restart i3 in place, preserving the layout
    bindsym $mod+Shift+r restart
    # Toggle light/dark desktop theme
    bindsym $mod+Shift+t exec theme-toggle toggle
    bindsym $mod+Ctrl+d exec theme-toggle dark
    bindsym $mod+Ctrl+l exec theme-toggle light

    # Exit i3 (logs you out of your X session)
    bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b split h
    bindsym $mod+v split v

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen toggle

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # i3 has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via WirePlumber. wpctl ships with the
    # PipeWire session manager itself; pactl would mean pulling in the whole
    # PulseAudio package for one client binary whose server half goes unused.
    # -l caps at 100%, which pactl enforced but wpctl does not by default.
    bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym XF86AudioLowerVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
    bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    # Special keys to adjust brightness via brightnessctl
    bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
    bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
    # Special key to take a screenshot with flameshot
    bindsym Print exec flameshot gui
    bindsym $mod+Print exec flameshot screen
    # Lock the screen on demand
    bindsym $mod+Shift+x exec loginctl lock-session

# floating window rules
for_window [class="Pavucontrol"] floating enable, resize set 600 500, move position mouse, move down 36 px

# design
smart_borders no_gaps
smart_gaps on
gaps inner 0
gaps outer 0
default_border pixel 1
default_floating_border pixel 1

# Status bar
#
# polybar replaces i3bar; launch.sh tears down any previous instance, so this
# is safe on reload. The i3status config is kept around as a fallback for the
# plain `bar {}` block.
exec_always --no-startup-id ~/.config/polybar/launch.sh

#####################
# Personal config
#####################
#
# Everything below is my own addition, layered on top of the ported sway
# config above.

# Focus only follows the keyboard. Without this, moving the pointer across a
# window steals focus, which fights with keyboard-driven window switching.
focus_follows_mouse no

# Launch IDEs
bindsym F2 exec emacs
bindsym F1 exec code

# Application assignments

# Open certain apps on a fixed workspace, wherever they're launched from.
assign [class="(?i)(zen|firefox|chrome|chromium)"] number 1
assign [class="(?i)thunderbird"] number 2
assign [class="(?i)code"] number 3
assign [class="(?i)emacs"] number 3
