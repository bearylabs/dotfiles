[branch]
	sort = -committerdate
[column]
	ui = auto
[core]
	editor = nvim
[fetch]
	prune = true
	writeCommitGraph = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	updateRefs = true
[rerere]
	enabled = true
[include]
	path = ~/.gitconfig.profile
[include]
	path = ~/.gitconfig.local
[credential "https://siempelkamp.ghe.com"]
	provider = github
	helper = 
	helper = !/nix/store/8q6jczz4f4llbzn3ji6cfp7z4bhny5za-gh-2.100.0/bin/.gh-wrapped auth git-credential
[core]
	excludesfile = ~/.gitignore_global
[credential "https://gist.siempelkamp.ghe.com"]
	helper = 
	helper = !/nix/store/8q6jczz4f4llbzn3ji6cfp7z4bhny5za-gh-2.100.0/bin/.gh-wrapped auth git-credential
